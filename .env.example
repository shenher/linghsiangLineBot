# 複製這個檔案為 .env（.env 本身已加入 .gitignore，不會被提交），並填入實際的機密值。
# docker-compose.yml 會從同層的 .env 讀取這些變數。

# Kestrel pfx 憑證密碼（certs/cert.pfx 的密碼）
CERT_PASSWORD=

# LINE Developers Console -> Basic settings
LINE_CHANNEL_SECRET=

# LINE Developers Console -> Messaging API（long-lived token）
LINE_CHANNEL_ACCESS_TOKEN=

# Ollama Cloud API Key（https://ollama.com 帳號設定頁面產生）
OLLAMA_CLOUD_API_KEY=

# 呼叫 DELETE /admin/blocklist/{userId} 解封端點時，要帶在 X-Admin-Api-Key 標頭的金鑰，自行設定一組即可
ADMIN_API_KEY=
